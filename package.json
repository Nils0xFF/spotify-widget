{
  "name": "lugia-spotify-widget",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prisma:studio": "npx prisma studio --port 5555 --browser none",
    "serve": "NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_EXTRA_CA_CERTS=./myapp.local.pem npx next dev --turbopack --experimental-https --experimental-https-key=./myapp.local-key.pem --experimental-https-cert=./myapp.local.pem",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev": "npm run prisma:studio & npm run serve",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.9.1",
    "@prisma/client": "^6.8.2",
    "lodash": "^4.17.21",
    "next": "15.3.2",
    "next-auth": "^5.0.0-beta.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "^5.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/lodash": "^4.17.17",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "prisma": "^6.8.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
